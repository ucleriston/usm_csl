.venv/
__pycache__/
*.pyc
markitdown/

# Cienciometria: exportações proprietárias e saídas de trabalho
cienciometria/revisoes/*/dados/bruto/*
!cienciometria/revisoes/*/dados/bruto/.gitkeep
cienciometria/revisoes/*/dados/processado/*
!cienciometria/revisoes/*/dados/processado/.gitkeep
cienciometria/revisoes/*/saidas/*
!cienciometria/revisoes/*/saidas/.gitkeep
